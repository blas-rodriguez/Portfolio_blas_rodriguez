---
interface Props {
  name:
    | 'arrow'
    | 'github'
    | 'linkedin'
    | 'mail'
    | 'external'
    | 'download'
    | 'location'
    | 'check'
    | 'code'
    | 'sun'
    | 'moon'
    | 'menu'
    | 'close'
    | 'play'
    | 'whatsapp';
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'arrow' && (
      <>
        <>
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </>
      </>
    )
  }
  {
    name === 'github' && (
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.3 4 5 5 0 0 0 19.2.5S18 0 15 2a13.4 13.4 0 0 0-7 0C5-.1 3.8.5 3.8.5A5 5 0 0 0 3.7 4a5.4 5.4 0 0 0-1.5 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4" />
    )
  }
  {
    name === 'linkedin' && (
      <>
        <>
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" />
          <path d="M2 9h4v12H2z" />
          <path d="M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
        </>
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <>
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-10 7L2 7" />
        </>
      </>
    )
  }
  {
    name === 'external' && (
      <>
        <>
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </>
      </>
    )
  }
  {
    name === 'download' && (
      <>
        <>
          <path d="M12 3v12" />
          <path d="m7 10 5 5 5-5" />
          <path d="M5 21h14" />
        </>
      </>
    )
  }
  {
    name === 'location' && (
      <>
        <>
          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
          <circle cx="12" cy="10" r="2.5" />
        </>
      </>
    )
  }
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {
    name === 'code' && (
      <>
        <>
          <path d="m8 9-4 3 4 3" />
          <path d="m16 9 4 3-4 3" />
          <path d="m14 5-4 14" />
        </>
      </>
    )
  }
  {
    name === 'sun' && (
      <>
        <>
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </>
      </>
    )
  }
  {name === 'moon' && <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />}
  {
    name === 'menu' && (
      <>
        <>
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </>
      </>
    )
  }
  {
    name === 'close' && (
      <>
        <>
          <path d="m6 6 12 12" />
          <path d="m18 6-12 12" />
        </>
      </>
    )
  }
  {name === 'play' && <path d="m8 5 11 7-11 7V5Z" />}
  {
    name === 'whatsapp' && (
      <>
        <>
          <path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 20.5l1.5-5.4A8.4 8.4 0 1 1 21 11.5Z" />
          <path d="M8.2 7.8c.2-.4.4-.4.7-.4h.4c.2 0 .4.1.5.4l.8 1.8c.1.3.1.5-.1.7l-.6.7c-.2.2-.1.4 0 .6.7 1.2 1.6 2.1 2.8 2.7.2.1.4.1.6-.1l.8-1c.2-.2.4-.3.7-.2l1.8.8c.3.1.4.3.4.5 0 .5-.2 1.4-.7 1.8-.5.5-1.3.8-2.1.8-1 0-2.8-.5-4.8-2.3-2.4-2.1-3-4.4-3-5.4 0-.6.2-1.1.5-1.4.3-.3.7-.5 1.3-.5Z" />
        </>
      </>
    )
  }
</svg>
