---
import { Image } from 'astro:assets';
import portrait from '../assets/blas-rodriguez.png';
import Icon from './Icon.astro';
import { copy, heroTags, profile } from '../data/profile';
import { translate, type Locale } from '../data/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (value: Parameters<typeof translate>[0]) => translate(value, locale);
---

<section class="hero" id="home">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow hero-glow--one" aria-hidden="true"></div>
  <div class="hero-glow hero-glow--two" aria-hidden="true"></div>
  <div class="container hero-layout">
    <div class="hero-copy">
      <div class="status-pill reveal">
        <span class="status-dot"></span>
        {t(copy.hero.eyebrow)}
      </div>
      <p class="hero-greeting reveal reveal--delay-1">{t(copy.hero.greeting)}</p>
      <h1 class="reveal reveal--delay-1">{t(copy.hero.headline)}</h1>
      <p class="hero-summary reveal reveal--delay-2">{t(copy.hero.summary)}</p>

      <div class="hero-actions reveal reveal--delay-2">
        <a class="button" href="#projects">{t(copy.common.viewWork)}<Icon name="arrow" size={18} /></a>
        <a class="button button--secondary" href={`mailto:${profile.email}`}>{t(copy.common.contactMe)}</a>
        <a
          class="button button--secondary button--whatsapp"
          href={profile.whatsapp}
          target="_blank"
          rel="noreferrer"
        >
          <Icon name="whatsapp" size={18} />WhatsApp
        </a>
      </div>

      <div class="hero-social reveal reveal--delay-3">
        <a href={profile.github} target="_blank" rel="noreferrer"><Icon name="github" size={18} />GitHub</a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer"
          ><Icon name="linkedin" size={18} />LinkedIn</a
        >
        <span><Icon name="location" size={17} />{t(copy.hero.location)}</span>
      </div>

      <div class="tag-list hero-tags reveal reveal--delay-3">
        {heroTags.map((tag) => <span>{tag}</span>)}
      </div>
    </div>

    <div class="hero-portrait-wrap reveal reveal--delay-2">
      <div class="portrait-code portrait-code--top" aria-hidden="true">
        <span>01</span>
        <code>solve(realProblem)</code>
      </div>
      <div class="hero-portrait">
        <div class="portrait-frame">
          <Image
            src={portrait}
            alt={t(copy.hero.photoAlt)}
            widths={[420, 612]}
            sizes="(max-width: 760px) 82vw, 440px"
            loading="eager"
            fetchpriority="high"
            quality={88}
          />
        </div>
        <div class="portrait-accent" aria-hidden="true"></div>
      </div>
      <div class="experience-chip">
        <strong>10<span>+</span></strong>
        <small>{t(copy.hero.experienceLabel)}</small>
      </div>
      <div class="portrait-code portrait-code--bottom" aria-hidden="true">
        <span>02</span>
        <code>ship(reliableSoftware)</code>
      </div>
    </div>
  </div>
  <div class="container scroll-cue" aria-hidden="true"><span></span>SCROLL</div>
</section>
